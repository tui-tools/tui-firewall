# A router ruleset in the shape the router profile provisions: one table the
# tool owns, filter chains for the three directions, the two NAT chains, and
# the named sets the rules use as aliases.
table inet tui {
	set lan_hosts {
		type ipv4_addr
		flags interval
		comment "hosts allowed to reach the router services"
		elements = { 10.10.0.0/24, 192.168.50.10 }
	}

	set lan6_hosts {
		type ipv6_addr
		comment "the v6 half of the same list"
		elements = { fd00:10::5, fd00:10::6 }
	}

	set admin_ports {
		type inet_service
		flags interval
		comment "ports the admin network may reach"
		elements = { 22, 9090-9095 }
	}

	chain input {
		type filter hook input priority filter; policy drop;
		iifname "lo" accept comment "loopback"
		ct state established,related accept comment "keep state"
		ip saddr @lan_hosts tcp dport @admin_ports counter accept comment "admin from lan"
		ip6 saddr @lan6_hosts tcp dport 22 counter accept comment "admin from lan v6"
		iifname "wan0" tcp dport 22 counter drop comment "no ssh from the wan"
		iifname "wan0" ip protocol icmp counter accept comment "ping from the wan"
		counter log prefix "tui input drop " level info
	}

	chain output {
		type filter hook output priority filter; policy accept;
		oifname "wan0" udp dport 123 counter accept comment "ntp out"
		oifname "wan0" tcp dport 25 counter reject with tcp reset comment "no smtp out"
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state established,related accept comment "keep state"
		iifname "lan0" oifname "wan0" counter accept comment "lan to wan"
		iifname "wan0" oifname "lan0" ip daddr 10.10.0.5 tcp dport 80 counter accept comment "port forward return path"
		iifname "lan0" ip saddr @lan_hosts oifname "lan0" counter accept comment "lan to lan"
	}

	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		iifname "wan0" tcp dport 8080 counter dnat ip to 10.10.0.5:80 comment "web port forward"
		iifname "wan0" udp dport 51820 counter dnat ip to 10.10.0.9:51820 comment "wireguard port forward"
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "wan0" counter masquerade comment "wan nat"
		oifname "wan1" counter masquerade comment "backup uplink nat"
		ip saddr 10.10.0.5 oifname "wan0" counter snat ip to 203.0.113.9 comment "static outbound address"
	}

	chain admin_services {
		ip saddr @lan_hosts tcp dport 9090 counter accept comment "cockpit"
	}
}
